{
  "app-id": "mx.pwmc.Svgvi",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "mx.pwmc.Svgvi",
  "finish-args": [
    "--share=ipc",
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/share/vala",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "gxml",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gxml.git",
          "tag": "0.20.4",
          "commit": "101eb887d6d656cdccd8866457f5448bebeddb14"
        }
      ]
    },
    {
      "name": "gresg",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/gsvg/gresg.git",
          "tag": "0.6.0",
          "commit": "464e1b2c5313c4cd9e7efc521ac28ccd57588b0d"
        }
      ]
    },
    {
      "name": "gsvg",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/gsvg/gsvg.git",
          "tag": "0.10.6",
          "commit": "d8ae82032a5ffed1a5aa2d91e2a6033cc6f1c6f5"
        }
      ]
    },
    {
      "name": "gsvgtk",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=false",
        "-Dtests=false",
        "-Ddemo=false"
      ],
      "build-options": {
        "ldflags": "-lm"
      },
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/gsvg/gsvgtk.git",
          "tag": "0.16.0",
          "commit": "252c64f79a2696fcf06b3d8b3885c53642975563"
        }
      ]
    },
    {
      "name": "svgvi",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/gsvg/svgvi.git",
          "tag": "3.0.0",
          "commit": "c402ed84017d36037d313c63154d3ddd456a4608"
        }
      ]
    }
  ]
}
